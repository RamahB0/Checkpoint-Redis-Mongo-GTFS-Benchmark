# Copy to .env and fill in real values for a real run. Never commit
# the real .env file (it's in .gitignore).

# MongoDB Atlas connection string (see README.md "Running it for real").
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-url>/gtfs_benchmark?retryWrites=true&w=majority

# A managed Redis instance (Redis Cloud, Upstash, etc.) or a local
# `redis-server`.
REDIS_URL=redis://localhost:6379
